# Public console (host / player) — local dev config.
# Copy to `.env` and fill with your deployed stack outputs:
#   cp .env.example .env
# Values come from the backend SAM stack outputs (HttpApiUrl / WsApiUrl).
# In CI these are injected automatically from the stack; `.env` is gitignored.

VITE_API_URL=https://<your-http-api-id>.execute-api.ap-northeast-2.amazonaws.com
VITE_WS_URL=wss://<your-ws-api-id>.execute-api.ap-northeast-2.amazonaws.com/prod
